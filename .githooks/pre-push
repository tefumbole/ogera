#!/usr/bin/env bash
# Blocks pushes that leave Ogera, then auto-bumps the ERP patch version.
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

# --- Isolation: this repository may only ever push to Ogera's own remote. -----
PUSH_URL="${2:-}"
if [[ -n "$PUSH_URL" ]] && ! echo "$PUSH_URL" | grep -qi 'tefumbole/ogera'; then
  echo "" >&2
  echo "PUSH BLOCKED — destination is not Ogera's repository:" >&2
  echo "  $PUSH_URL" >&2
  echo "" >&2
  echo "Ogera may only push to github.com/tefumbole/ogera." >&2
  exit 1
fi

bash tools/guard-isolation.sh >/dev/null || {
  echo "" >&2
  echo "PUSH BLOCKED — isolation check failed. Run: npm run guard" >&2
  exit 1
}

if [[ "${SKIP_VERSION_BUMP:-}" == "1" ]]; then
  exit 0
fi

while read -r local_ref local_sha remote_ref remote_sha; do
  [[ -z "${local_ref:-}" ]] && continue

  if [[ "$local_sha" == "0000000000000000000000000000000000000000" ]]; then
    continue
  fi

  range="${remote_sha}..${local_sha}"
  if [[ "$remote_sha" == "0000000000000000000000000000000000000000" ]]; then
    changed_files="$(git log --format= --name-only "$local_sha" 2>/dev/null || true)"
  else
    changed_files="$(git diff --name-only $range 2>/dev/null || true)"
  fi

  if echo "$changed_files" | grep -q 'appVersion.js'; then
    continue
  fi

  # Sync only. laravel-app/VERSION is the source of truth and pre-commit already
  # advanced it, so bumping again here would overshoot what was deployed.
  NEXT="$(node tools/bump-version.js --sync | awk '{print $3}')"
  git add src/constants/appVersion.js apps/api/src/constants/appVersion.js
  git commit -m "chore: bump version to ${NEXT}" --no-verify
done

exit 0
