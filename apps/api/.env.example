# Ogera API — production template. Fill in Ogera's own host and credentials.
PORT=3003
NODE_ENV=production
CORS_ORIGIN=https://example.com
APP_URL=https://example.com
JWT_SECRET=change_this_to_a_long_random_string

# Ogera must always use its own database — never an AlphaBridge or BeyondTechWorld one.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=ogera
DB_PASSWORD=your_mysql_password
DB_NAME=ogera

# Wasender
WASENDER_API_KEY=
WASENDER_BASE_URL=https://wasenderapi.com/api
COMPANY_NAME=Ogera Rwanda Events

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

SEED_ADMIN_EMAIL=admin@ogera.rw
SEED_ADMIN_PASSWORD=ChangeMe@123456
